#!/usr/bin/env python3
"""Archive the reviewed working tree, excluding ignored build products and secrets."""
import pathlib
import subprocess
import sys
import tarfile

root = pathlib.Path(__file__).resolve().parent.parent
output, version = sys.argv[1:]
paths = subprocess.check_output(
    ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=root
).split(b"\0")
with tarfile.open(output, "w") as archive:
    for entry in sorted(set(paths)):
        if not entry:
            continue
        relative = entry.decode("utf-8")
        if relative.startswith("docs/assets/ui-overhaul/"):
            continue
        source = root / relative
        if source.is_file() or source.is_symlink():
            archive.add(source, arcname=f"Atten-{version}/{relative}", recursive=False)
