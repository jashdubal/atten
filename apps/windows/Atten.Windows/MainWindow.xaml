<Window
    x:Class="Atten.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atten.Windows"
    Title="Atten">
    <Grid x:Name="Root"
          Background="{ThemeResource AttenCanvasBrush}">
        <Grid.KeyboardAccelerators>
            <!-- Keep the two high-frequency actions available without a
                 mouse. The focused control still owns normal Enter/Escape. -->
            <KeyboardAccelerator Key="Enter"
                                 Modifiers="Control"
                                 Invoked="OnGenerateKeyboardAccelerator" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnCancelKeyboardAccelerator" />
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        CompactModeThresholdWidth="700"
                        ExpandedModeThresholdWidth="1000"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Create" />
                <NavigationViewItem Content="Studio" Tag="Studio" IsSelected="True"
                                    AutomationProperties.Name="Studio" />
                <NavigationViewItem Content="Playground" Tag="Playground"
                                    AutomationProperties.Name="Playground" />
                <NavigationViewItemHeader Content="Manage" />
                <NavigationViewItem Content="Voices" Tag="Voices"
                                    AutomationProperties.Name="Voices" />
                <NavigationViewItem Content="Projects" Tag="Projects"
                                    AutomationProperties.Name="Projects" />
                <NavigationViewItem Content="Exports" Tag="Exports"
                                    AutomationProperties.Name="Exports" />
                <NavigationViewItem Content="Settings &amp; Models" Tag="Settings"
                                    AutomationProperties.Name="Settings and speech models" />
            </NavigationView.MenuItems>

            <NavigationView.Header>
                <StackPanel Spacing="2" Padding="4,0,0,4">
                    <TextBlock x:Name="ScreenTitle"
                               Text="Studio"
                               Style="{StaticResource AttenPageTextStyle}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScreenSubtitle"
                               Text="Create speech locally"
                               Style="{StaticResource AttenSecondaryTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.Header>

            <Grid Padding="28,12,28,20" RowSpacing="16"
                  Background="{ThemeResource AttenCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="GeneratingProgress"
                                 IsIndeterminate="True"
                                 Visibility="{Binding GeneratingVisibility}"
                                 MinHeight="4" />
                </StackPanel>

                <!-- Studio Panel -->
                <Grid x:Name="StudioPanel" Grid.Row="1" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StudioEditorColumn" Width="*" MinWidth="280" />
                        <ColumnDefinition x:Name="StudioInspectorColumn" Width="340" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock Text="Create speech" Style="{StaticResource TitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="1" />
                        <TextBlock Text="Write a script, choose a supported local voice, and generate audio."
                                   Style="{StaticResource AttenSecondaryTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBox Header="Project title"
                                 x:Name="ProjectTitleTextBox"
                                 Text="{Binding DraftTitle, Mode=TwoWay}"
                                 PlaceholderText="Untitled narration"
                                 AutomationProperties.Name="Project title" />
                        <TextBox Header="Script"
                                 x:Name="ScriptTextBox"
                                 Text="{Binding DraftText, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="360"
                                 PlaceholderText="Start writing or paste text here..."
                                 AutomationProperties.Name="Speech script"
                                 AutomationProperties.HelpText="Text to synthesize with the selected voice" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="14" Padding="0,0,8,0">
                            <ComboBox Header="Model / Engine"
                                      ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Language"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Voice"
                                      ItemsSource="{Binding StudioVoices}"
                                      SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:Voice">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Gender}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Slider Header="Speed"
                                    Minimum="0.5"
                                    Maximum="2"
                                    StepFrequency="0.05"
                                    Value="{Binding Speed, Mode=TwoWay}" />

                            <ComboBox Header="Format"
                                      ItemsSource="{Binding Formats}"
                                      SelectedItem="{Binding Format, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <ComboBox Header="Acceleration"
                                      ItemsSource="{Binding DeviceModes}"
                                      SelectedItem="{Binding DeviceMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />

                            <Button x:Name="GenerateButton"
                                    Content="Generate Speech"
                                    Style="{StaticResource AttenPrimaryButtonStyle}"
                                    Click="OnGenerateClicked"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0"
                                    AutomationProperties.Name="Generate speech" />

                            <Button Content="Cancel"
                                    Click="OnCancelClicked"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Cancel generation" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Playground Panel -->
                <StackPanel x:Name="PlaygroundPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Playground" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Explore voices, text-to-speech experimentation, and instant previews across all installed models." TextWrapping="Wrap" />
                </StackPanel>

                <!-- Voices Panel -->
                <Grid x:Name="VoicesPanel" Grid.Row="1" RowSpacing="14" Visibility="Collapsed"
                      AutomationProperties.Name="Voices and languages">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Voices &amp; Languages" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBox Grid.Row="1"
                             Header="Filter voices"
                             Text="{Binding VoiceSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search by voice name, language (e.g. Arabic, German), engine, or trait..." />
                    <ListView Grid.Row="2" ItemsSource="{Binding GroupedVoices}" SelectionMode="None"
                              AutomationProperties.Name="Available voices">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:VoiceGroup">
                                <StackPanel Spacing="6" Margin="0,4,0,16">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <TextBlock Text="{x:Bind Header}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind Voices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:Voice">
                                                <Grid Padding="12,8" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Language}" Opacity="0.7" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Gender}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" />
                                                    <Border Grid.Column="2" Background="{ThemeResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{x:Bind Quality}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Button Grid.Column="3" Content="Use Voice" Click="OnUseVoiceClicked" Tag="{x:Bind Id}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Projects Panel -->
                <Grid x:Name="ProjectsPanel" Grid.Row="1" RowSpacing="12" Visibility="Collapsed"
                      AutomationProperties.Name="Projects">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Projects" Style="{StaticResource TitleTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{Binding Projects}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProjectRecord">
                                <StackPanel Padding="0,8" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind AudioPath}" Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Exports Panel -->
                <StackPanel x:Name="ExportsPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Exports" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{Binding OutputDirectory}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Settings & Hugging Face Discovery Panel -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="Settings and speech models">
                    <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings &amp; Speech Models" Style="{StaticResource TitleTextBlockStyle}" />
                        
                        <TextBox Header="Export folder" Text="{Binding OutputDirectory, Mode=TwoWay}" />

                        <!-- Local Models Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Speech Engines &amp; Models" FontWeight="SemiBold" FontSize="16" />
                                
                                <ItemsControl ItemsSource="{Binding InstalledEngines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:InstalledModelItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Description}" Opacity="0.7" FontSize="12" />
                                                        </StackPanel>

                                                        <!-- Installed badge -->
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Visibility="{x:Bind InstalledBadgeVisibility, Mode=OneWay}"
                                                                    VerticalAlignment="Center">
                                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                            <TextBlock Text="Installed" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" FontSize="12" />
                                                        </StackPanel>

                                                        <!-- Action Buttons: Download, Pause, Cancel, Delete -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <!-- Download / Resume button if not installed -->
                                                            <Button Content="{x:Bind DownloadButtonText, Mode=OneWay}"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="OnDownloadInstalledEngineClicked"
                                                                    Visibility="{x:Bind DownloadButtonVisibility, Mode=OneWay}" />

                                                            <!-- Pause button while downloading -->
                                                            <Button Content="Pause"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="OnPauseEngineClicked"
                                                                    Visibility="{x:Bind DownloadingVisibility, Mode=OneWay}" />

                                                            <!-- Cancel button while downloading or paused -->
                                                            <Button Content="Cancel"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="OnCancelEngineClicked"
                                                                    Visibility="{x:Bind CancelButtonVisibility, Mode=OneWay}" />

                                                            <!-- Delete button if installed and not bundled -->
                                                            <Button Tag="{x:Bind Id}"
                                                                    Click="OnDeleteEngineClicked"
                                                                    Visibility="{x:Bind DeleteButtonVisibility, Mode=OneWay}"
                                                                    ToolTipService.ToolTip="Delete model and free disk space">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                    <TextBlock Text="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Progress & Metrics while downloading -->
                                                    <StackPanel Spacing="6" Visibility="{x:Bind DownloadingVisibility, Mode=OneWay}">
                                                        <ProgressBar Value="{x:Bind DownloadProgress, Mode=OneWay}"
                                                                     Maximum="100"
                                                                     MinHeight="6" />

                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind DownloadSpeed, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" />
                                                                <TextBlock Text="•" Opacity="0.5" FontSize="11" />
                                                                <TextBlock Text="{x:Bind DownloadEta, Mode=OneWay}" Opacity="0.8" FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind DownloadSize, Mode=OneWay}" Opacity="0.8" FontSize="11" />
                                                        </Grid>

                                                        <TextBlock Text="{x:Bind DownloadStatus, Mode=OneWay}"
                                                                   FontSize="11"
                                                                   Opacity="0.8"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Hugging Face Model Discovery Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Discover TTS Models from Hugging Face" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Popular community and neural TTS architectures, ratings, and language tags." Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Click="OnRefreshHfModelsClicked" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Model Filters: Language, Sort By, Installed Status, Search -->
                                <Grid ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Header="Search models"
                                             Text="{Binding HfSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Search by model name, author..." />

                                    <ComboBox Grid.Column="1"
                                              Header="Language filter"
                                              ItemsSource="{Binding HfLanguages}"
                                              SelectedItem="{Binding SelectedHfLanguage, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />

                                    <ComboBox Grid.Column="2"
                                              Header="Sort by"
                                              ItemsSource="{Binding HfSortOptions}"
                                              SelectedItem="{Binding SelectedHfSort, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />

                                    <ComboBox Grid.Column="3"
                                              Header="Installation status"
                                              ItemsSource="{Binding HfFilters}"
                                              SelectedItem="{Binding SelectedHfFilter, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding FilteredHfModels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:HfModelInfo">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="14,10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" />
                                                            <TextBlock Text="{x:Bind Author}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind DownloadsText}" Opacity="0.8" FontSize="12" />
                                                            <TextBlock Text="•" Opacity="0.4" FontSize="12" />
                                                            <TextBlock Text="{x:Bind LikesText}" Opacity="0.8" FontSize="12" />
                                                            <TextBlock Text="⭐" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Text="•" Opacity="0.4" FontSize="12" />
                                                            <TextBlock Text="{x:Bind SizeText}" Opacity="0.8" FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>

                                                        <TextBlock Text="{x:Bind LanguagesText}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                        <Button Tag="{x:Bind Id}"
                                                                Content="Download"
                                                                Click="OnDownloadHfModelClicked"
                                                                Visibility="{x:Bind InstallButtonVisibility, Mode=OneWay}"
                                                                IsEnabled="{x:Bind DownloadButtonEnabled, Mode=OneWay}" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Visibility="{x:Bind InstalledBadgeVisibility, Mode=OneWay}"
                                                                    VerticalAlignment="Center">
                                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                                                            <TextBlock Text="Installed" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold" FontSize="12" />
                                                        </StackPanel>

                                                        <!-- Delete button if installed and not Kokoro bundled -->
                                                        <Button Tag="{x:Bind Id}"
                                                                Click="OnDeleteHfModelClicked"
                                                                Visibility="{x:Bind DeleteButtonVisibility, Mode=OneWay}"
                                                                ToolTipService.ToolTip="Delete model and free disk space"
                                                                Padding="8,4">
                                                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="All models and speech synthesis run 100% locally. No cloud subscription or API key is required." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Interactive Media Player Bar (Bottom) -->
                <Border Grid.Row="2"
                        Background="{ThemeResource AttenSurfaceBrush}"
                        BorderBrush="{ThemeResource AttenSeparatorBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,10"
                        Visibility="{Binding PlayerVisibility}"
                        AutomationProperties.Name="Audio player">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Play/Pause Button -->
                        <Button Click="OnTogglePlayPauseClicked"
                                Style="{StaticResource AttenPrimaryButtonStyle}"
                                Padding="12,8"
                                ToolTipService.ToolTip="Play / Pause"
                                AutomationProperties.Name="Play or pause audio">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="{Binding PlayPauseIcon}" FontSize="12" />
                                <TextBlock Text="{Binding PlayPauseLabel}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Title and Seek Slider -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerTitle}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <Slider Value="{Binding PlayerPosition, Mode=TwoWay}"
                                    Maximum="{Binding PlayerDuration}"
                                    ValueChanged="OnPlayerSeekValueChanged"
                                    PointerEntered="OnPlayerSeekPointerEntered"
                                    PointerCaptureLost="OnPlayerSeekPointerCaptureLost"
                                    Margin="0,-4,0,-4"
                                    AutomationProperties.Name="Audio position" />
                        </StackPanel>

                        <!-- Time text -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PlayerTimeText}"
                                   VerticalAlignment="Center"
                                   Opacity="0.8"
                                   FontFamily="Consolas"
                                   FontSize="12" />

                        <!-- Reveal Button -->
                        <Button Grid.Column="3"
                                Content="Reveal in Folder"
                                Click="OnRevealClicked"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Reveal audio in folder" />

                        <!-- Close Button -->
                        <Button Grid.Column="4"
                                Click="OnClosePlayerClicked"
                                VerticalAlignment="Center"
                                Padding="8,6"
                                AutomationProperties.Name="Close audio player"
                                ToolTipService.ToolTip="Close audio player">
                            <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
