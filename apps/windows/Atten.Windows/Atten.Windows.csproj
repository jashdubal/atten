<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Atten.Windows</RootNamespace>
    <Version>0.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      Generates the app's resources.pri, which is where the compiled XAML for
      App and MainWindow lives. Without it the framework loads but the app's
      own markup cannot be found, and the window throws XamlParseException
      before anything is shown. Unpackaged apps need this just as much as
      packaged ones.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      An unpackaged WinUI app otherwise expects Microsoft.WindowsAppRuntime to
      have been installed separately.  Bundle it beside the application so a
      freshly installed copy can start on a clean Windows machine.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\resources\voices.json" Link="resources\voices.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
